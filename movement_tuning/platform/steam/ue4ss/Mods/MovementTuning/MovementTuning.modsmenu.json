    {
      "key": "AutoSprint",
      "type": "toggle",
      "label": {
        "en": "Auto sprint",
        "zh-Hans": "自动冲刺"
      },
      "help": {
        "en": "Push the left stick all the way to sprint, without holding the dodge button. On the keyboard, the move keys count as the stick all the way: you sprint whenever you move. Holding the button still works. The game's walk key (Left Alt by default) stops it.",
        "zh-Hans": "将左摇杆推到底即可冲刺，无需长按闪避键。使用键盘时，移动键等同于摇杆推到底：只要移动就会冲刺。长按闪避键仍然可用。游戏自带的行走键（默认左 Alt）会停止自动冲刺。"
      },
      "default": true
    },

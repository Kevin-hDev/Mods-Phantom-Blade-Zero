{
  "title": {
    "en": "Dodge Jump",
    "zh-Hans": "闪避跳跃"
  },
  "description": {
    "en": "Double and triple jumps in the air, with the game's own dodge animations. A jump pressed just before or just after landing is no longer lost: you jump again as soon as the game allows it.",
    "zh-Hans": "在空中进行二段跳和三段跳，使用游戏自带的闪避动作。落地前一瞬或刚落地时按下的跳跃键不会再被吞掉：游戏一允许，角色就会立即起跳。"
  },
  "version": "1.0.6",
  "settings": [
    {
      "key": "Enabled",
      "type": "toggle",
      "label": {
        "en": "Enabled",
        "zh-Hans": "启用"
      },
      "help": {
        "en": "Off: the mod does nothing. No jumps in the air, and a jump pressed early is lost again.",
        "zh-Hans": "关闭：模组不再生效。无法在空中跳跃，提前按下的跳跃键也会再次被吞掉。"
      },
      "default": true
    },
    {
      "key": "Chains",
      "type": "choice",
      "slider": true,
      "label": {
        "en": "Air jump sets",
        "zh-Hans": "空中跳跃组数"
      },
      "help": {
        "en": "1: a double jump, then a triple jump. 2: two of each. 3: three of each, six jumps in the air.",
        "zh-Hans": "1：一次二段跳，然后一次三段跳。2：各两次。3：各三次，共六次空中跳跃。"
      },
      "default": "1",
